#!/bin/sh
# Strip AI attribution trailers from the commit message.
msg_file="$1"
tmp_file="$msg_file.tmp"
grep -v -i -E '^Co-Authored-By:.*(claude|anthropic)|^Claude-Session:|Generated with.*Claude' "$msg_file" > "$tmp_file" || true
# Drop trailing blank lines left behind by removed trailers.
awk '{ lines[NR] = $0 } END { n = NR; while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print lines[i] }' "$tmp_file" > "$msg_file"
rm -f "$tmp_file"
if ! grep -q -v -E '^[[:space:]]*(#|$)' "$msg_file"; then
  echo "commit-msg: message is empty after removing attribution lines." >&2
  exit 1
fi
if LC_ALL=C grep -q "$(printf '\342\200\224')" "$msg_file"; then
  echo "commit-msg: message contains an em dash (U+2014). Use a comma, colon, or parentheses." >&2
  exit 1
fi
